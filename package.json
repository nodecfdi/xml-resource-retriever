{
  "name": "@nodecfdi/xml-resource-retriever",
  "type": "module",
  "version": "3.0.0",
  "packageManager": "pnpm@12.23.0",
  "description": "XSD and XSLT resource downloader for local storage",
  "author": "Fernando Isidro <luffynando@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/nodecfdi/xml-resource-retriever",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodecfdi/xml-resource-retriever.git"
  },
  "bugs": {
    "url": "https://github.com/nodecfdi/xml-resource-retriever/issues"
  },
  "keywords": [
    "XSD",
    "XLST",
    "downloader",
    "retriver",
    "local",
    "storage",
    "node",
    "nodejs"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.13.0 || ^24 || ^26"
  },
  "scripts": {
    "prepare": "is-in-ci || husky",
    "changelog": "auto-changelog -u -p",
    "commitlint": "commitlint --edit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tool:code": "pnpm run lint:check && pnpm run typecheck",
    "tool:build": "pnpm run tool:code && pnpm run test:run",
    "build": "tsdown",
    "release": "release-it"
  },
  "dependencies": {
    "@nodecfdi/cfdi-core": "^2.0.0",
    "file-type": "^22.3.0",
    "mime": "^4.1.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eienjs/eslint-config": "^2.3.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "^5.1.1",
    "auto-changelog": "^2.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-erasable-syntax-only": "^0.7.2",
    "husky": "^9.1.7",
    "is-in-ci": "^2.0.0",
    "release-it": "^21.1.3",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "auto-changelog": {
    "template": "keepachangelog",
    "hideCredit": true,
    "commitLimit": false
  },
  "release-it": {
    "git": {
      "commit": true,
      "tag": true,
      "push": true,
      "requireCleanWorkingDir": true,
      "commitMessage": "chore(release): :tada: v${version}",
      "tagAnnotation": "chore(release): :tada: v${version}"
    },
    "github": {
      "release": true,
      "web": true,
      "releaseName": "Release v${version}"
    },
    "npm": {
      "publish": true,
      "publishPackageManager": "pnpm",
      "publishArgs": [
        "--no-git-checks"
      ]
    },
    "hooks": {
      "before:init": [
        "pnpm run lint:check",
        "pnpm run typecheck",
        "pnpm test:run"
      ],
      "after:bump": [
        "pnpm run build",
        "pnpm run changelog"
      ]
    }
  },
  "nodecfdi": {
    "title": "XML Resource Retriever",
    "icon": "i-tabler-file-download",
    "category": "utilities"
  }
}
