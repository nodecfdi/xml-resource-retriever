{
  "name": "@nodecfdi/xml-resource-retriever",
  "description": "XSD and XLST resource downloader for local storage",
  "version": "2.0.1",
  "type": "module",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/esm/types.d.ts",
        "default": "./dist/esm/types.js"
      },
      "require": {
        "types": "./dist/commonjs/types.d.ts",
        "default": "./dist/commonjs/types.js"
      }
    }
  },
  "imports": {
    "#src/*": "./src/*.js"
  },
  "scripts": {
    "prepare": "is-in-ci || husky",
    "changelog": "auto-changelog -u -p",
    "commitlint": "commitlint --edit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tool:code": "pnpm run lint:check && pnpm run typecheck",
    "tool:build": "pnpm run tool:code && pnpm run test:run",
    "build": "tsdown",
    "release": "release-it"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@nodecfdi/cfdi-core": "^0.6.2",
    "@types/node": "^20.16.11",
    "@vitest/coverage-istanbul": "^2.1.3",
    "auto-changelog": "^2.5.0",
    "glob": "^11.0.0",
    "husky": "^9.1.6",
    "is-in-ci": "^1.0.0",
    "jest-xml-matcher": "^1.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "file-type": "^19.6.0",
    "mime": "^4.0.4"
  },
  "peerDependencies": {
    "@nodecfdi/cfdi-core": ">=0.6.2"
  },
  "author": "Fernando Isidro <luffynando@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/nodecfdi/xml-resource-retriever",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodecfdi/xml-resource-retriever.git"
  },
  "bugs": {
    "url": "https://github.com/nodecfdi/xml-resource-retriever/issues"
  },
  "keywords": [
    "XSD",
    "XLST",
    "downloader",
    "retriver",
    "local",
    "storage",
    "node",
    "nodejs"
  ],
  "engines": {
    "node": "^22.13.0 || ^24 || ^26"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@12.23.0",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "auto-changelog": {
    "template": "keepachangelog",
    "hideCredit": true,
    "commitLimit": false
  }
}